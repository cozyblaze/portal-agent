+
+	void QueueTasRunDone(bool aborted, const char* reason)
+	{
+		nlohmann::json response;
+		response["type"] = "tas_run_done";
+		if (tasPlayback.hasId)
+			response["id"] = tasPlayback.id;
+		response["ok"] = true;
+		response["aborted"] = aborted;
+		if (reason)
+			response["reason"] = reason;
+		response["ticks"] = tasPlayback.ticksExecuted;
+		response["requested_ticks"] = tasPlayback.requestedTicks;
+		response["playback_mode"] = "srctas";
+		response["input_mode"] = "srctas";
+		response["simulated_ticks"] = tasPlayback.simulatedTicks;
+		response["accepted_host_tick"] = tasPlayback.acceptedHostTick;
+		response["first_simulated_host_tick"] = tasPlayback.firstSimulatedHostTick;
+		response["last_simulated_host_tick"] = tasPlayback.lastSimulatedHostTick;
+		response["pause_request_host_tick"] = tasPlayback.pauseRequestHostTick;
+		response["direct_pause"] = tasPlayback.directPauseUsed;
+		response["mouse_input_suppressed"] = tasPlayback.mouseInputSuppressed;
+		response["mouse_input_restored"] = tasPlayback.mouseInputRestored;
+		if (tasPlayback.mouseInputSuppressed)
+			response["mouse_enable_before_playback"] = tasPlayback.mouseEnableBeforePlayback;
+
+		// Observations (and the raw angles) are filled in by
+		// FlushPendingTasReport once the final tick has actually simulated.
+		pendingTasReport = PendingTasReport();
+		pendingTasReport.pending = true;
+		pendingTasReport.includePosition = tasPlayback.includePosition;
+		pendingTasReport.response = std::move(response);
+	}
+
+	void FlushPendingTasReport()
+	{
+		if (!pendingTasReport.pending || pendingTasReport.waitForAgentReady)
+			return;
+		if (pendingTasReport.readyRenderFramesLeft > 0)
+		{
+			--pendingTasReport.readyRenderFramesLeft;
+			return;
+		}
+
+		nlohmann::json response = std::move(pendingTasReport.response);
+		const bool includePosition = pendingTasReport.includePosition;
+		pendingTasReport = PendingTasReport();
+
+		AddObservationFields(response, true, includePosition);
+
+		if (EngineGetViewAngles)
+		{
+			float angles[3]{};
+			EngineGetViewAngles(angles);
+			response["angles"] = AnglesToJson(angles);
+		}
+
+		ipc::Send(response);
+	}
+
+	void StopTasPlayback(bool aborted, const char* reason)
+	{
+		if (!tasPlayback.active)
+			return;
+		const bool agentRunBootstrap = tasPlayback.agentRunBootstrap;
+
+		spt_afterframes.ResetAfterframesQueue();
+		ReleaseAllTasButtons();
+		if (EngineConCmd)
+			EngineConCmd("spt_tas_pause 0");
+		tasPlayback.ticksExecuted = tasPlayback.simulatedTicks;
+		tasPlayback.pauseRequestHostTick = GetHostTick();
+		tasPlayback.directPauseUsed = SptSetPausedDirect(true);
+		if (!tasPlayback.directPauseUsed && EngineConCmd)
+			EngineConCmd("setpause");
+		RestoreTasMouse();
+		if (!agentRunBootstrap)
+			QueueTasRunDone(aborted, reason);
+		tasPlayback = TasPlayback();
+		sourceTasSessionInitialized = false;
+		if (agentRunBootstrap && agentRun.active && agentRun.waitingForLoad)
+			agentRun.bootstrapStarted = false;
+	}
+
+	void FinishAgentRunReady()
+	{
+		if (!agentRun.active || !agentRun.waitingForLoad)
+			return;
+
+		SptDisarmPortalStartPause();
+		agentRun.waitingForLoad = false;
+		agentRun.readyTransitionPending = false;
+		agentRun.initialPortalStartReached = true;
+		agentRun.bootstrapStarted = false;
+		if (g_pCVar)
+		{
+			if (ConVar* fpsMax = g_pCVar->FindVar("fps_max"))
+				fpsMax->SetValue(1.0f / spt_tickrate.GetTickrate());
+			if (ConVar* mouseEnable = g_pCVar->FindVar("cl_mouseenable"))
+				mouseEnable->SetValue(0);
+		}
+		tas_pause.SetValue(1);
+		if (pendingTasReport.pending && pendingTasReport.waitForAgentReady)
+		{
+			pendingTasReport.waitForAgentReady = false;
+			pendingTasReport.readyRenderFramesLeft = AGENT_RUN_POST_READY_RENDER_FRAMES;
+		}
+		Msg("Agent run ready: demo recording is active and simulation is TAS-paused.\n");
+	}
+
+	void CompleteSourceTasPlayback()
+	{
+		if (!tasPlayback.active)
+			return;
+
+		// The terminal zero-tick framebulk enables tas_pause before this marker.
+		// The requested native timeline has simulated completely, while the
+		// engine remains in phase for the next agent segment.
+		const bool agentRunBootstrap = tasPlayback.agentRunBootstrap;
+		const bool exactTicks = tasPlayback.simulatedTicks == tasPlayback.requestedTicks;
+		tasPlayback.ticksExecuted = tasPlayback.simulatedTicks;
+		tasPlayback.pauseRequestHostTick = GetHostTick();
+		RestoreTasMouse();
+		if (agentRunBootstrap)
+		{
+			tasPlayback = TasPlayback();
+			if (exactTicks)
+				FinishAgentRunReady();
+			else
+			{
+				sourceTasSessionInitialized = false;
+				agentRun.bootstrapStarted = false;
+				// The first native boundary can be consumed by the direct pause that
+				// spt_pause_on_portal_start just applied. Retrying from tas_pause is the
+				// normal phase-alignment path and is intentionally silent.
+			}
+			return;
+		}
+
+		if (exactTicks)
+			QueueTasRunDone(false, nullptr);
+		else
+			QueueTasRunDone(true, "native TAS timeline simulated the wrong number of ticks");
+		tasPlayback = TasPlayback();
+	}
+
+	void MarkSourceTasPlaybackStarted()
+	{
+		if (tasPlayback.active)
+			tasPlayback.sourceInputStarted = true;
+	}
+
+	void OnTasLevelInit(const char*)
+	{
+		sourceTasSessionInitialized = false;
+		if (agentRun.active)
+		{
+			agentRun.waitingForLoad = true;
+			agentRun.readyTransitionPending = false;
+			agentRun.spawnSignonReceived = false;
+			agentRun.fullSignonReceived = false;
+			agentRun.bootstrapStarted = false;
+			agentRun.bootstrapFailureReported = false;
+			agentRun.postSignonTicks = 0;
+		}
+	}
+
+	void OnTasLevelShutdown()
+	{
+		if (tasPlayback.active)
+		{
+			const bool waitForAgentReady = agentRun.active && !tasPlayback.agentRunBootstrap;
+			StopTasPlayback(true, "level shutdown");
+			if (waitForAgentReady && pendingTasReport.pending)
+				pendingTasReport.waitForAgentReady = true;
+		}
+		sourceTasSessionInitialized = false;
+	}
+
+	void OnTasFinishRestore(void*)
+	{
+		sourceTasSessionInitialized = false;
+		if (agentRun.active && agentRun.waitingForLoad)
+			agentRun.readyTransitionPending = true;
+	}
+
+	void TasRunCallback(const nlohmann::json& msg)
+	{
+		if (agentRun.active && agentRun.waitingForLoad)
+		{
+			SendErrorResponse("tas_run", msg, "start_run is still loading the player");
+			return;
+		}
+		if (tasPlayback.active)
+		{
+			SendErrorResponse("tas_run", msg, "a tas_run is already active");
+			return;
+		}
+		if (!EngineConCmd || !EngineGetViewAngles || !EngineSetViewAngles)
+		{
+			SendErrorResponse("tas_run", msg, "engine access is unavailable");
+			return;
+		}
+
+		if (!TickSignal.Works)
+		{
+			SendErrorResponse("tas_run", msg, "tick callback is unavailable");
+			return;
+		}
+
+		std::vector<TasStep> steps;
+		std::string error;
+		if (!ParseTasSteps(msg, steps, error))
+		{
+			SendErrorResponse("tas_run", msg, error);
+			return;
+		}
+
+		bool includePosition = false;
+		if (!ReadOptionalBool(msg, "include_position", includePosition, error))
+		{
+			SendErrorResponse("tas_run", msg, error);
+			return;
+		}
+
+		if (!ValidateNativeTasOptions(msg, error))
+		{
+			SendErrorResponse("tas_run", msg, error);
+			return;
+		}
+
+		if (!AfterFramesSignal.Works)
+		{
+			SendErrorResponse("tas_run", msg, "native TAS scheduling is unavailable");
+			return;
+		}
+
+		long long totalTicks = 0;
+		for (const TasStep& step : steps)
+			totalTicks += step.ticks;
+
+		tasPlayback = TasPlayback();
+		tasPlayback.active = true;
+		tasPlayback.includePosition = includePosition;
+		tasPlayback.steps = std::move(steps);
+		tasPlayback.requestedTicks = totalTicks;
+		tasPlayback.acceptedHostTick = GetHostTick();
+		auto id = msg.find("id");
+		if (id != msg.end())
+		{
+			tasPlayback.hasId = true;
+			tasPlayback.id = *id;
+		}
+
+		if (!QueueSourceTasPlayback(tasPlayback.steps, error))
+		{
+			tasPlayback = TasPlayback();
+			SendErrorResponse("tas_run", msg, error);
+			return;
+		}
+
+		nlohmann::json response;
+		response["type"] = "tas_run";
+		AddMessageId(msg, response);
+		response["ok"] = true;
+		response["steps"] = tasPlayback.steps.size();
+		response["ticks"] = totalTicks;
+		response["playback_mode"] = "srctas";
+		response["input_mode"] = "srctas";
+		response["direct_pause_available"] = SptCanSetPausedDirect();
+		response["mouse_input_suppressed"] = tasPlayback.mouseInputSuppressed;
+		if (tasPlayback.mouseInputSuppressed)
+			response["mouse_enable_before_playback"] = tasPlayback.mouseEnableBeforePlayback;
+		response["accepted_host_tick"] = tasPlayback.acceptedHostTick;
+		ipc::Send(response);
+	}
