+		if (tickCount <= 0 || tickCount > MAX_TAS_TICKS)
+		{
+			error = std::string(prefix) + ".ticks must be between 1 and "
+			        + std::to_string(MAX_TAS_TICKS);
+			return false;
+		}
+		step.ticks = static_cast<int>(tickCount);
+
+		auto keys = json.find("keys");
+		if (keys != json.end())
+		{
+			if (!keys->is_object())
+			{
+				error = std::string(prefix) + ".keys must be an object";
+				return false;
+			}
+
+			for (auto it = keys->begin(); it != keys->end(); ++it)
+			{
+				if (!it.value().is_boolean())
+				{
+					error = std::string(prefix) + ".keys." + it.key()
+					        + " must be a boolean";
+					return false;
+				}
+
+				bool matched = false;
+				for (std::size_t b = 0; b < TAS_BUTTON_COUNT; ++b)
+				{
+					if (it.key() == TAS_BUTTONS[b].name)
+					{
+						if (it.value().get<bool>())
+							step.buttons |= 1u << b;
+						matched = true;
+						break;
+					}
+				}
+
+				if (!matched)
+				{
+					error = std::string(prefix) + ".keys has unknown key \""
+					        + it.key() + "\"";
+					return false;
+				}
+			}
+		}
+
+		if (!ReadStepAngleField(json, "pitch", step.hasPitchDelta, step.pitchDelta, error)
+		    || !ReadStepAngleField(json, "yaw", step.hasYawDelta, step.yawDelta, error)
+		    || !ReadStepAngleField(json, "pitch_to", step.hasPitchAbs, step.pitchAbs, error)
+		    || !ReadStepAngleField(json, "yaw_to", step.hasYawAbs, step.yawAbs, error))
+		{
+			error = std::string(prefix) + ": " + error;
+			return false;
+		}
+
+		if ((step.hasPitchDelta && step.hasPitchAbs) || (step.hasYawDelta && step.hasYawAbs))
+		{
+			error = std::string(prefix) + " mixes relative and absolute angles for the same axis";
+			return false;
+		}
+
+		return true;
+	}
+
+	bool ParseTasSteps(const nlohmann::json& msg, std::vector<TasStep>& steps, std::string& error)
+	{
+		auto stepsIt = msg.find("steps");
+		if (stepsIt == msg.end() || !stepsIt->is_array() || stepsIt->empty())
+		{
+			error = "steps must be a non-empty array";
+			return false;
+		}
+
+		if (stepsIt->size() > MAX_TAS_STEPS)
+		{
+			error = "too many steps (max " + std::to_string(MAX_TAS_STEPS) + ")";
+			return false;
+		}
+
+		long long totalTicks = 0;
+		steps.reserve(stepsIt->size());
+		for (std::size_t i = 0; i < stepsIt->size(); ++i)
+		{
+			TasStep step;
+			if (!ParseTasStep((*stepsIt)[i], i, step, error))
+				return false;
+
+			totalTicks += step.ticks;
+			if (totalTicks > MAX_TAS_TICKS)
+			{
+				error = "total ticks exceed the limit of " + std::to_string(MAX_TAS_TICKS);
+				return false;
+			}
+
+			steps.push_back(step);
+		}
+
+		return true;
+	}
+
+	std::string SourceTasFloat(float value)
+	{
+		std::ostringstream stream;
+		stream << std::setprecision(std::numeric_limits<float>::max_digits10) << value;
+		return stream.str();
+	}
+
+	std::string BuildSourceTasFramebulk(const TasStep& step,
+	                                    float targetAngles[3],
+	                                    const char* consoleCommand = "")
+	{
+		std::string movement = "------";
+		if (step.buttons & (1u << TAS_BUTTON_FORWARD))
+			movement[0] = 'f';
+		if (step.buttons & (1u << TAS_BUTTON_LEFT))
+			movement[1] = 'l';
+		if (step.buttons & (1u << TAS_BUTTON_RIGHT))
+			movement[2] = 'r';
+		if (step.buttons & (1u << TAS_BUTTON_BACK))
+			movement[3] = 'b';
+
+		std::string other = "--------";
+		if (step.buttons & (1u << TAS_BUTTON_JUMP))
+			other[0] = 'j';
+		if (step.buttons & (1u << TAS_BUTTON_DUCK))
+			other[1] = 'd';
+		if (step.buttons & (1u << TAS_BUTTON_USE))
+			other[2] = 'u';
+		if (step.buttons & (1u << TAS_BUTTON_ATTACK))
+			other[3] = '1';
+		if (step.buttons & (1u << TAS_BUTTON_ATTACK2))
+			other[4] = '2';
+
+		std::string yaw = "-";
+		std::string pitch = "-";
+		if (step.hasYawAbs || step.hasYawDelta)
+		{
+			const float value = step.hasYawAbs ? step.yawAbs : targetAngles[VIEW_YAW] + step.yawDelta;
+			targetAngles[VIEW_YAW] = static_cast<float>(utils::NormalizeDeg(value));
+			yaw = SourceTasFloat(targetAngles[VIEW_YAW]);
+		}
+		if (step.hasPitchAbs || step.hasPitchDelta)
+		{
+			const float value =
+			    step.hasPitchAbs ? step.pitchAbs : targetAngles[VIEW_PITCH] + step.pitchDelta;
+			targetAngles[VIEW_PITCH] = ClampFloat(value, -89.0f, 89.0f);
+			pitch = SourceTasFloat(targetAngles[VIEW_PITCH]);
+		}
+
+		std::ostringstream line;
+		line << "----------|" << movement << '|' << other << '|' << yaw << '|' << pitch << '|' << step.ticks
+		     << '|' << consoleCommand;
+		return line.str();
+	}
+
+	scripts::FrameBulkOutput CompileSourceTasFramebulk(const std::string& line)
+	{
+		std::istringstream input(line);
+		scripts::FrameBulkInfo info(input);
+		return scripts::HandleFrameBulk(info);
+	}
+
+	void CaptureTasMouseState()
+	{
+		if (tasPlayback.mouseEnableCaptured || !g_pCVar)
+			return;
+
+		ConVar* mouseEnable = g_pCVar->FindVar("cl_mouseenable");
+		if (!mouseEnable)
+			return;
+
+		tasPlayback.mouseEnableBeforePlayback = mouseEnable->GetInt();
+		tasPlayback.mouseEnableCaptured = true;
+	}
+
+	void DisableTasMouse()
+	{
+		CaptureTasMouseState();
+		if (!tasPlayback.mouseEnableCaptured || !g_pCVar)
+			return;
+
+		ConVar* mouseEnable = g_pCVar->FindVar("cl_mouseenable");
+		if (!mouseEnable)
+			return;
+
+		mouseEnable->SetValue(0);
+		tasPlayback.mouseInputSuppressed = !mouseEnable->GetBool();
+	}
+
+	void RestoreTasMouse()
+	{
+		if (!tasPlayback.mouseEnableCaptured)
+			return;
+
+		if (g_pCVar)
+		{
+			ConVar* mouseEnable = g_pCVar->FindVar("cl_mouseenable");
+			if (mouseEnable)
+			{
+				mouseEnable->SetValue(tasPlayback.mouseEnableBeforePlayback);
+				tasPlayback.mouseInputRestored =
+				    mouseEnable->GetInt() == tasPlayback.mouseEnableBeforePlayback;
+			}
+		}
+
+		tasPlayback.mouseEnableCaptured = false;
+	}
+
+	bool QueueSourceTasPlayback(const std::vector<TasStep>& steps, std::string& error)
+	{
+		if (spt_afterframes.HasAfterFramesEntries())
+		{
+			error = "the native afterframes queue is busy";
+			return false;
+		}
+
+		try
+		{
+			const bool initializeSession = !sourceTasSessionInitialized;
+			if (initializeSession)
+				scripts::g_TASReader.ResetConvars();
+			SptPrepareForUnpause();
+			CaptureTasMouseState();
+
+			float targetAngles[3]{};
+			EngineGetViewAngles(targetAngles);
+			std::vector<scripts::FrameBulkOutput> outputs;
+			outputs.reserve(steps.size());
+			for (const TasStep& step : steps)
+			{
+				std::string line = BuildSourceTasFramebulk(step, targetAngles);
+				outputs.push_back(CompileSourceTasFramebulk(line));
+			}
+
+			const float tickTime = spt_tickrate.GetTickrate();
+			ConVar* fpsMax = g_pCVar ? g_pCVar->FindVar("fps_max") : nullptr;
+			if (!fpsMax)
+				throw std::runtime_error("fps_max is unavailable");
+			// fps_max is FCVAR_NOT_CONNECTED, so a normal console assignment is
+			// rejected once a map is active. Set it directly, as spt_cvar does,
+			// to keep host_framerate at one game tick per rendered frame without
+			// making the game run faster than real time after the segment.
+			fpsMax->SetValue(1.0f / tickTime);
+
+			// Keep the engine's TAS/usercmd phase alive between agent plans while
+			// freezing simulation time. A normal engine setpause/unpause boundary
+			// makes a segmented plan diverge from the same continuous srctas
+			// timeline; tas_pause holds host_frametime at zero instead.
+			//
+			// Compile completion as a real neutral framebulk. Besides running the
+			// marker, this emits the same -forward/-jump/etc. transitions as an
+			// ordinary srctas boundary, so an action cannot remain held while the
+			// agent is thinking or leak into the next plan.
+			TasStep terminalStep;
+			terminalStep.ticks = 0;
+			scripts::FrameBulkOutput terminalOutput = CompileSourceTasFramebulk(
+			    BuildSourceTasFramebulk(terminalStep,
+			                            targetAngles,
+			                            "spt_tas_pause 1;spt_ipc_tas_complete"));
+
+			// Use ParsedScript::AddFrameBulk and the global afterframes queue just
+			// like SourceTASReader::Execute. This keeps input transitions on the
+			// exact scheduler used by ordinary .srctas playback.
+			scripts::ParsedScript timeline;
+			timeline.Reset();
+			for (auto& output : outputs)
+				timeline.AddFrameBulk(output);
+			timeline.AddFrameBulk(terminalOutput);
+
+			tasPlayback.sourceInputStarted = false;
+
+			// Freeze before arming the queue so the first segment and every later
+			// segment begin in the same phase. Without this, the very first plan can
+			// inherit a running frame while plans after it begin under tas_pause.
+			tas_pause.SetValue(1);
+
+			for (auto entry : timeline.afterFramesEntries)
+			{
+				// afterframes decrements before testing for zero, so offsets 0 and 1
+				// both execute on the first queue pass. Normal srctas startup absorbs
+				// that phase in its save/load bootstrap; an agent segment starts in an
+				// already-loaded, tas-paused map. The pass that clears tas_pause also
+				// has zero host_frametime, so the first simulation happens on the next
+				// pass. Keep tick-zero input at zero and shift later boundaries by two
+				// frames so a length-N bulk actually simulates N ticks.
+				if (entry.framesLeft > 0)
+					entry.framesLeft += 2;
+				spt_afterframes.AddAfterFramesEntry(std::move(entry));
+			}
+			// Append this zero-frame entry after the first framebulk's zero-frame
+			// entries. OnFrame therefore applies the input while frozen, then
+			// resumes simulation in the same native scheduling pass.
+			spt_afterframes.AddAfterFramesEntry(
+			    afterframes_entry_t(0, "spt_tas_pause 0;unpause;spt_ipc_tas_started"));
+			spt_afterframes.ResumeAfterframesQueue();
+
+			std::string startCommand;
+			if (initializeSession)
+			{
+				std::ostringstream initialize;
+				initialize << ";spt_pause 0;spt_resetpitchyaw;tas_aim_reset;host_framerate "
+				           << std::setprecision(std::numeric_limits<float>::max_digits10) << tickTime;
+				startCommand = initialize.str();
+			}
+			if (tasPlayback.mouseEnableCaptured)
+				startCommand += ";cl_mouseenable 0";
+			if (tasPlayback.agentRunBootstrap)
+				startCommand += ";hideconsole";
+			DisableTasMouse();
+			EngineConCmd(startCommand.c_str());
+
+			sourceTasSessionInitialized = true;
+			return true;
+		}
+		catch (const std::exception& ex)
+		{
+			RestoreTasMouse();
+			error = std::string("failed to compile native TAS framebulks: ") + ex.what();
+			return false;
+		}
+	}
+
