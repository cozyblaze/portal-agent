+	void ApplyTasButtonsViaConsole(unsigned buttons)
+	{
+		for (std::size_t b = 0; b < TAS_BUTTON_COUNT; ++b)
+		{
+			if (buttons & (1u << b))
+				EngineConCmd(TAS_BUTTONS[b].pressCmd);
+			else
+				EngineConCmd(TAS_BUTTONS[b].releaseCmd);
