+{
+	return spt_portal_start_pause.HasFired();
+}
+
+bool PortalStartPauseFeature::ShouldLoadFeature()
+{
+	return interfaces::engine_client != nullptr;
+}
+
+void PortalStartPauseFeature::LoadFeature()
+{
+	// Without the tick signal the feature can never fire; don't register
+	// convars that would silently do nothing.
+	if (!TickSignal.Works)
+		return;
+
+	InitConcommandBase(spt_pause_on_portal_start);
+	InitConcommandBase(spt_pause_on_portal_start_debug);
+
+	TickSignal.Connect(this, &PortalStartPauseFeature::Tick);
+
+	if (LevelInitSignal.Works)
+		LevelInitSignal.Connect(this, &PortalStartPauseFeature::LevelInit);
+
+	if (LevelShutdownSignal.Works)
+		LevelShutdownSignal.Connect(this, &PortalStartPauseFeature::LevelShutdown);
+}
+
+void PortalStartPauseFeature::UnloadFeature()
+{
+	Disarm();
+	ResetState();
+}
+
+void PortalStartPauseFeature::LevelInit(char const* pMapName)
+{
+	ResetState();
+
+	if (spt_pause_on_portal_start_debug.GetBool())
+		Msg("spt_pause_on_portal_start: level init %s\n", pMapName ? pMapName : "<null>");
+}
+
+void PortalStartPauseFeature::LevelShutdown()
+{
+	ResetState();
+}
+
+void PortalStartPauseFeature::Tick(bool simulating)
+{
+	if (!simulating || !armed || fired || !spt_pause_on_portal_start.GetBool())
+		return;
+
+	if (!utils::DoesGameLookLikePortal())
+		return;
+
+	if (!IsPortalStartMap())
+		return;
+
+	if (!spt_playerio.PlayerIOAddressesFound())
+		return;
+
+	FetchFields();
+
+	const bool atStart = IsAtPortalStart();
+	const bool playerView = IsUsingPlayerView();
+	const bool switchedToPlayerView = !previousPlayerView && playerView;
+
+	if (!playerView)
+		sawNonPlayerView = true;
+
+	if (spt_pause_on_portal_start_debug.GetBool() && playerView != previousPlayerView)
+	{
+		const Vector pos = spt_playerio.m_vecAbsOrigin.GetValue();
+		Msg("spt_pause_on_portal_start: player_view=%s pos=(%.3f %.3f %.3f) at_start=%s saw_camera=%s\n",
+		    playerView ? "true" : "false",
+		    pos.x,
+		    pos.y,
+		    pos.z,
+		    atStart ? "true" : "false",
+		    sawNonPlayerView ? "true" : "false");
+	}
+
+	previousPlayerView = playerView;
+
+	if (atStart && sawNonPlayerView && switchedToPlayerView)
+	{
+		tas_pause.SetValue(1);
+		armed = false;
+		fired = true;
+
+		if (spt_pause_on_portal_start_debug.GetBool())
+			Msg("spt_pause_on_portal_start: TAS-paused at Portal bed start.\n");
+	}
+}
+
+void PortalStartPauseFeature::ResetState()
+{
+	fired = false;
+	sawNonPlayerView = false;
+	previousPlayerView = true;
+	fetchedFields = false;
+	m_hViewEntity = PlayerField<CBaseHandle>();
+}
+
+void PortalStartPauseFeature::FetchFields()
+{
+	if (fetchedFields)
+		return;
+
+	m_hViewEntity = spt_entprops.GetPlayerField<CBaseHandle>("m_hViewEntity");
+	fetchedFields = true;
+
+	if (spt_pause_on_portal_start_debug.GetBool())
+		Msg("spt_pause_on_portal_start: m_hViewEntity %s.\n", m_hViewEntity.Found() ? "found" : "not found");
+}
+
+bool PortalStartPauseFeature::IsPortalStartMap()
+{
+	const char* map = utils::GetLoadedMap();
+	return map && std::strstr(map, "testchmb_a_00");
+}
+
+bool PortalStartPauseFeature::IsAtPortalStart()
+{
+	const Vector pos = spt_playerio.m_vecAbsOrigin.GetValue();
+
+	// Player origin at the testchmb_a_00 wake-up point (on the bed); the
+	// tolerance absorbs save/load and physics-settle jitter.
+	constexpr float targetX = -544.0f;
+	constexpr float targetY = -368.776f;
+	constexpr float targetZ = 160.0f;
+	constexpr float tolerance = 8.0f;
+
+	return std::fabs(pos.x - targetX) <= tolerance && std::fabs(pos.y - targetY) <= tolerance
+	       && std::fabs(pos.z - targetZ) <= tolerance;
+}
+
+bool PortalStartPauseFeature::IsUsingPlayerView()
+{
+	if (!m_hViewEntity.Found())
+		return true;
+
+	CBaseHandle viewEntity = m_hViewEntity.GetValue();
+	return !viewEntity.IsValid() || viewEntity.GetEntryIndex() == 1;
+}
