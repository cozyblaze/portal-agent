+			request.hasId = true;
+			request.id = *id;
+		}
+		pendingScreenshots.push_back(request);
+
+		nlohmann::json response;
+		response["type"] = "screenshot_ack";
+		AddMessageId(msg, response);
+		response["ok"] = true;
+		response["frames_until_capture"] = request.framesUntilCapture;
+		ipc::Send(response);
+	}
+
+	void CaptureAndSendScreenshot(const PendingScreenshotRequest& request)
+	{
+		if (!interfaces::materialSystem)
+		{
+			SendErrorResponse("screenshot", request, "material system is unavailable");
+			return;
+		}
+
+		int width = 0;
+		int height = 0;
+		interfaces::materialSystem->GetBackBufferDimensions(width, height);
+		if (width <= 0 || height <= 0)
+		{
+			SendErrorResponse("screenshot", request, "invalid backbuffer dimensions");
+			return;
+		}
+
+		constexpr std::size_t pixelSize = 3;
+		std::size_t sizeWidth = static_cast<std::size_t>(width);
+		std::size_t sizeHeight = static_cast<std::size_t>(height);
+		if (sizeWidth > (std::numeric_limits<std::size_t>::max)() / sizeHeight / pixelSize)
+		{
+			SendErrorResponse("screenshot", request, "screenshot dimensions overflow");
+			return;
+		}
+
+		std::size_t byteCount = sizeWidth * sizeHeight * pixelSize;
+		if (byteCount > MAX_SCREENSHOT_BYTES)
+		{
+			SendErrorResponse("screenshot", request, "screenshot is too large");
+			return;
+		}
+
+		std::vector<unsigned char> pixels(byteCount);
+		CMatRenderContextPtr renderContext(interfaces::materialSystem);
+		if (!renderContext)
+		{
+			SendErrorResponse("screenshot", request, "render context is unavailable");
+			return;
+		}
+		renderContext->ReadPixels(0, 0, width, height, pixels.data(), IMAGE_FORMAT_RGB888);
+
+		std::string encoded = Base64Encode(pixels.data(), pixels.size());
+		std::size_t chunks = (encoded.size() + SCREENSHOT_CHUNK_CHARS - 1) / SCREENSHOT_CHUNK_CHARS;
+
+		nlohmann::json begin;
+		begin["type"] = "screenshot_begin";
+		AddMessageId(request, begin);
+		begin["ok"] = true;
+		begin["width"] = width;
+		begin["height"] = height;
+		begin["format"] = "rgb8";
+		begin["encoding"] = "base64";
+		begin["origin"] = "top_left";
+		begin["stride"] = width * static_cast<int>(pixelSize);
+		begin["bytes"] = byteCount;
+		begin["encoded_bytes"] = encoded.size();
+		begin["chunk_size"] = SCREENSHOT_CHUNK_CHARS;
+		begin["chunks"] = chunks;
+		ipc::Send(begin);
+
+		for (std::size_t i = 0; i < chunks; ++i)
+		{
+			std::size_t offset = i * SCREENSHOT_CHUNK_CHARS;
+			std::size_t length = MinSize(SCREENSHOT_CHUNK_CHARS, encoded.size() - offset);
+			nlohmann::json chunk;
+			chunk["type"] = "screenshot_chunk";
+			AddMessageId(request, chunk);
+			chunk["index"] = i;
+			chunk["data"] = encoded.substr(offset, length);
+			ipc::Send(chunk);
+		}
+
+		nlohmann::json end;
+		end["type"] = "screenshot_end";
+		AddMessageId(request, end);
+		end["ok"] = true;
+		ipc::Send(end);
+	}
